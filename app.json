{
  "expo": {
    "name": "SIGNOVA",
    "slug": "signova-app",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SIGNOVA uses the camera to read sign language."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/signova"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#0f0f0f",
      "themeColor": "#0f0f0f"
    }
  }
}
